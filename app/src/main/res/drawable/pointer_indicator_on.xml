<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <gradient
                android:type="radial"
                android:gradientRadius="14dp"
                android:startColor="#6600E5FF"
                android:endColor="#0000E5FF" />
        </shape>
    </item>
    <item
        android:left="4dp"
        android:top="4dp"
        android:right="4dp"
        android:bottom="4dp">
        <shape android:shape="oval">
            <solid android:color="@color/neonCyan" />
            <stroke
                android:width="1dp"
                android:color="#CCFFFFFF" />
        </shape>
    </item>
</layer-list>
